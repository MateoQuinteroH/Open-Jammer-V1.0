		)
		(uuid "159d95d0-f5bf-4f79-8612-d23e9ee11220")
	)
	(text_box "MCP73831 calculations:\n* Ireg = 1000V/Rprog = 1000/2k = 500mA\n* Pdissipated=(Vin-Vbat)*Icharge=(5v-4.2v)*500mA=0.4W\n* ΔT = 0.4W * 230°C/W = 92°C"
		(exclude_from_sim yes)
		(at 20.32 96.52 0)
